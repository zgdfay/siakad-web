generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserMaster {
  id          String        @id @default(uuid())
  nimOrNip    String        @unique
  name        String
  role        Role
  status      UserStatus    @default(AKTIF)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  account     Account?
  pendaftaran Pendaftaran[]
}

model Account {
  id                String     @id @default(uuid())
  userMasterId      String     @unique
  email             String     @unique
  passwordHash      String
  resetToken        String?    @unique
  resetTokenExpires DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  userMaster        UserMaster @relation(fields: [userMasterId], references: [id])
}

model Semester {
  id                  String               @id @default(uuid())
  nama                String
  tahun               String
  periode             SemesterPeriode
  tanggalMulai        DateTime
  tanggalSelesai      DateTime
  deadlinePendaftaran DateTime
  status              SemesterStatus       @default(NONAKTIF)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  pendaftaran         Pendaftaran[]
  mataKuliah          SemesterMataKuliah[]

  @@unique([tahun, periode])
  @@index([status])
}

model MataKuliah {
  id        String               @id @default(uuid())
  kode      String               @unique
  nama      String
  sks       Int
  prodi     String
  kategori  MataKuliahKategori
  status    MataKuliahStatus     @default(AKTIF)
  deskripsi String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  semester  SemesterMataKuliah[]

  @@index([status])
  @@index([kode])
}

model SemesterMataKuliah {
  id                String              @id @default(uuid())
  semesterId        String
  mataKuliahId      String
  kelas             String
  jadwal            String
  tanggalJadwal     DateTime?
  dosen             String
  kuota             Int                 @default(0)
  terisi            Int                 @default(0)
  biaya             Int                 @default(0)
  prasyarat         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pendaftaranDetail PendaftaranDetail[]
  mataKuliah        MataKuliah          @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  semester          Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([semesterId, mataKuliahId, kelas])
  @@index([semesterId])
  @@index([mataKuliahId])
}

model Pendaftaran {
  id           String              @id @default(uuid())
  userMasterId String
  semesterId   String
  totalSKS     Int                 @default(0)
  totalBiaya   Int                 @default(0)
  status       PendaftaranStatus   @default(MENUNGGU_VERIFIKASI)
  catatan      String?
  catatanAdmin String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  payment      Payment?
  semester     Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  userMaster   UserMaster          @relation(fields: [userMasterId], references: [id], onDelete: Cascade)
  detail       PendaftaranDetail[]

  @@index([userMasterId])
  @@index([semesterId])
  @@index([status])
  @@index([createdAt])
}

model PendaftaranDetail {
  id                   String             @id @default(uuid())
  pendaftaranId        String
  semesterMataKuliahId String
  statusJadwal         JadwalStatus       @default(AKTIF)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  pendaftaran          Pendaftaran        @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  semesterMataKuliah   SemesterMataKuliah @relation(fields: [semesterMataKuliahId], references: [id], onDelete: Cascade)

  @@unique([pendaftaranId, semesterMataKuliahId])
  @@index([pendaftaranId])
  @@index([statusJadwal])
}

model Payment {
  id               String        @id @default(uuid())
  pendaftaranId    String        @unique
  jumlah           Int
  status           PaymentStatus @default(BELUM_BAYAR)
  metodePembayaran String?
  buktiPembayaran  String?
  tanggalBayar     DateTime?
  catatan          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  pendaftaran      Pendaftaran   @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

enum Role {
  MAHASISWA
  DOSEN
  ADMIN
}

enum UserStatus {
  AKTIF
  NONAKTIF
}

enum SemesterPeriode {
  GANJIL
  GENAP
}

enum SemesterStatus {
  AKTIF
  NONAKTIF
}

enum MataKuliahKategori {
  WAJIB
  PILIHAN
}

enum MataKuliahStatus {
  AKTIF
  NONAKTIF
}

enum PendaftaranStatus {
  MENUNGGU_VERIFIKASI
  DITERIMA
  DITOLAK
  DIBATALKAN
}

enum PaymentStatus {
  BELUM_BAYAR
  MENUNGGU_VERIFIKASI
  LUNAS
  DITOLAK
}

enum JadwalStatus {
  AKTIF
  SELESAI
}
