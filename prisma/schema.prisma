generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAHASISWA
  DOSEN
  ADMIN
}

enum UserStatus {
  AKTIF
  NONAKTIF
}

model UserMaster {
  id       String     @id @default(uuid())
  nimOrNip String     @unique
  name     String
  role     Role
  status   UserStatus @default(AKTIF)

  account Account?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String     @id @default(uuid())
  userMasterId String     @unique
  userMaster   UserMaster @relation(fields: [userMasterId], references: [id])

  email        String @unique
  passwordHash String

  resetToken        String?   @unique
  resetTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
